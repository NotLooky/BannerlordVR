<?xml version="1.0" encoding="utf-8"?>
<Module>
  <Name value="Bannerlord VR" />
  <Id value="BannerlordVR" />
  <!-- NUMBERS ONLY, after a single letter prefix: v0.1.0, optionally v0.1.0.0.
       The launcher parses this with TaleWorlds' ApplicationVersion, which
       int.Parses each dot-separated field. A prerelease suffix - v0.1.0-alpha.1
       - throws, and the launcher reports it as "Module ../../Modules/
       BannerlordVR can't be loaded, there are some errors. Input string was not
       in a correct format." The mod then does not load at all.

       So the alpha number lives in the git tag, the zip name and the CHANGELOG,
       never here. -->
  <Version value="v0.2.7" />
  <SingleplayerModule value="true" />

  <!-- Deliberately false. The camera and input hooks are indistinguishable from
       cheating to other players and to TaleWorlds' server logic. -->
  <MultiplayerModule value="false" />

  <DependedModules>
    <DependedModule Id="Native" />
    <DependedModule Id="SandBoxCore" />
    <!-- "Sandbox", lowercase b. The FOLDER is Modules\SandBox, but the Id
         declared inside its SubModule.xml is "Sandbox". Matching the folder
         name here makes the dependency unresolvable and the launcher greys
         out our checkbox. -->
    <DependedModule Id="Sandbox" />
    <DependedModule Id="StoryMode" />
    <!-- Verified against Modules/Bannerlord.Harmony/SubModule.xml: the Id is
         "Bannerlord.Harmony". Its <Name> is the bare "Harmony", which is what
         the launcher DISPLAYS - declaring that as the Id greys us out exactly
         the way the Sandbox case above does. -->
    <DependedModule Id="Bannerlord.Harmony" />
  </DependedModules>

  <SubModules>
    <SubModule>
      <Name value="BannerlordVR" />
      <DLLName value="BannerlordVR.dll" />
      <SubModuleClassType value="BannerlordVR.SubModule" />
      <Tags>
        <Tag key="DedicatedServerType" value="none" />
        <Tag key="IsNoRenderModeElement" value="false" />
      </Tags>
    </SubModule>
  </SubModules>

  <!-- bvr_severed_head: the meshless head armour a beheaded agent wears
       (enemy physics, VR/Physics/DismemberFx). Sold nowhere; only the
       physics equips it. -->
  <Xmls>
    <XmlNode>
      <XmlName id="Items" path="bvr_items" />
      <IncludedGameTypes>
        <GameType value="Campaign" />
        <GameType value="CampaignStoryMode" />
        <GameType value="CustomGame" />
      </IncludedGameTypes>
    </XmlNode>
  </Xmls>
</Module>
