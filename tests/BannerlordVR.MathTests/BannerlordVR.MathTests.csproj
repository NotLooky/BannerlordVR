<Project Sdk="Microsoft.NET.Sdk">

  <!-- =====================================================================
       VrMath / VrCameraDriver verification.

       A plain console app returning 0 or 1 rather than a test framework. The
       assertions here are about the SHIPPED TaleWorlds assemblies - what
       MatrixFrame.TransformToParent actually computes, what Mat3.TransformToLocal
       actually computes - so the value is in running them against the real game
       DLLs on this machine. Adding xunit would buy a nicer runner and a second
       toolchain dependency, and nothing else.

       Run:  dotnet build tests\BannerlordVR.MathTests
             build\tests\BannerlordVR.MathTests.exe
       ===================================================================== -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>BannerlordVR.MathTests</AssemblyName>
    <RootNamespace>BannerlordVR.MathTests</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\build\tests\</OutputPath>

    <BannerlordDir Condition="'$(BannerlordDir)' == ''">E:\steam\steamapps\common\Mount &amp; Blade II Bannerlord</BannerlordDir>
    <GameBinDir>$(BannerlordDir)\bin\Win64_Shipping_Client</GameBinDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- The test host is a standalone exe, so unlike the module itself it DOES
       need local copies of the engine assemblies it touches. -->
  <ItemGroup>
    <Reference Include="TaleWorlds.Library">
      <HintPath>$(GameBinDir)\TaleWorlds.Library.dll</HintPath>
    </Reference>
    <Reference Include="TaleWorlds.Engine">
      <HintPath>$(GameBinDir)\TaleWorlds.Engine.dll</HintPath>
    </Reference>
    <Reference Include="TaleWorlds.DotNet">
      <HintPath>$(GameBinDir)\TaleWorlds.DotNet.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- No Properties= on this reference, deliberately. Passing global properties
       (SkipDeploy=true was the tempting one) makes MSBuild treat BannerlordVR as
       a SECOND project instance, distinct from the one the solution builds. Both
       instances then build in parallel into the same obj\ and collide:

         CS2012: Cannot open '...\obj\Debug\BannerlordVR.dll' for writing

       which reads like a stale lock from a running game and is not. The tests
       therefore build the module exactly as the solution does, deploy included. -->
  <ItemGroup>
    <ProjectReference Include="..\..\managed\BannerlordVR\BannerlordVR.csproj" />
  </ItemGroup>

</Project>
